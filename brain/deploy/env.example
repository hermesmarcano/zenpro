# /opt/zen-brain/.env  — permisos 600, dueño zen.  NUNCA subir este archivo a un repositorio.
# Genera cada secreto con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Hermes (solo loopback; el adaptador es el único que lo llama) -------------------------------------------
ZEN_HERMES_URL=http://127.0.0.1:8642/v1/chat/completions
ZEN_HERMES_MODEL=zen-brain
# La clave de la API de Hermes (la misma que API_SERVER_KEY de Hermes). Mínimo 32 caracteres.
ZEN_HERMES_API_KEY=
ZEN_HERMES_TIMEOUT=60

# --- Teléfono --------------------------------------------------------------------------------------------------------
# Los tokens de los teléfonos NO van aquí: se crean con `zenctl tokens add <nombre>` y solo se guarda su hash.
# (ZEN_PHONE_TOKEN ya no existe: poner esa variable impide arrancar, porque un token en el entorno no se puede revocar.)
ZEN_TOKENS_FILE=/opt/zen-brain/tokens.json

# --- Rutas ------------------------------------------------------------------------------------------------------------
ZEN_DATA_DIR=/opt/zen-brain/data
ZEN_AUDIT_PATH=/opt/zen-brain/audit/audit.jsonl
ZEN_PORT=8787

# --- Lo que el cerebro puede hacer -----------------------------------------------------------------------------
# Apps que el modelo puede pedir bloquear (además, el teléfono solo bloquea las que tengan una regla en «Límites»).
# Vacío = el cerebro no bloquea nada. Las apps protegidas (Ajustes, teléfono, SMS, bancos…) se rechazan al arrancar.
ZEN_BLOCK_ALLOWLIST=
ZEN_BLOCK_MAX_MINUTES=240
ZEN_PAUSE_MAX_MINUTES=120
ZEN_MAX_BLOCKS_PER_HOUR=3
ZEN_MAX_NOTIFIES_PER_HOUR=6
ZEN_MAX_DRAFTS_PER_HOUR=20
ZEN_MAX_PAUSES_PER_HOUR=2
# Tope ACUMULADO en 24 h: aunque se repitan las órdenes, no se encadenan bloqueos o pausas sin fin.
ZEN_BLOCK_MINUTES_PER_DAY=240
ZEN_PAUSE_MINUTES_PER_DAY=120
# Eventos que se aceptan por hora y dispositivo; más es una avalancha (o un teléfono roto) y se responde 429.
ZEN_MAX_EVENTS_PER_HOUR=2000

# --- Calendario ------------------------------------------------------------------------------------------------
# El modelo puede PROPONER eventos («cena mañana a las 9»). Nunca se agenda solo: el teléfono muestra una notificación «Agendar»
# y, al tocarla, abre tu calendario con el evento ya relleno; tú lo guardas.
ZEN_CALENDAR=on
# TU zona horaria (la hora que ves en el reloj), para convertir «mañana a las 9»: America/Sao_Paulo, Europe/Madrid, UTC…
ZEN_TIMEZONE=UTC
ZEN_MAX_CALENDAR_PER_HOUR=6

# --- Qué llega al modelo y cuánto cuesta ------------------------------------------------------------------------
# «screen» (texto de pantalla) va apagado: es mucho texto y expone más. Añádelo solo si lo necesitas.
ZEN_MODEL_KINDS=notification,transcript
ZEN_MAX_CALLS_PER_HOUR=60
ZEN_MAX_CALLS_PER_DAY=400
# «event»: sesión nueva por evento (un mensaje malicioso no contamina los siguientes). «device»: un hilo por teléfono.
ZEN_SESSION_MODE=event
# Para la estimación de coste de `stats` (precio por 1000 tokens de tu modelo en OpenRouter; 0 = no estimar).
ZEN_COST_PER_1K_TOKENS=0

# --- Voz ----------------------------------------------------------------------------------------------------------------
ZEN_STT=whisper
ZEN_WHISPER_MODEL=small
ZEN_WHISPER_LANGUAGE=es
